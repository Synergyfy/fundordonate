# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5024
CORS_ORIGIN=http://localhost:5023

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# NOTE: the password is URL-encoded (e.g. `#` -> `%23`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fundordonate?schema=public

# ─── Redis (BullMQ + shared client + OAuth state store) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT (local sessions issued after SSO / admin login) ─────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key (32 bytes / 64 hex chars) for encrypting MCOM tokens at rest
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# ─── MCOM Solutions Central Hub (SSO / Identity) ─────────────────────────────
MCOM_SOLUTIONS_URL=http://localhost:3010
MCOM_CLIENT_ID=fundordonate
MCOM_CLIENT_SECRET=your-oauth-client-secret
# Server-to-server API key (alias: MCOM_SOLUTION_API_KEY)
MCOM_API_KEY=your-shared-system-api-key
MCOM_HMAC_SECRET=your-hmac-data-sharing-secret
MCOM_WEBHOOK_SECRET=your-webhook-signing-secret
MCOM_PLATFORM_SLUG=fundordonate
# Must exactly match a redirectUri registered for this client in MCOM Console
MCOM_REDIRECT_URI=http://localhost:5023/auth/callback
MCOM_SCOPES=profile email business membership packages

# Flow B — direct dashboard handshake shared secret (leave empty to disable)
SSO_SECRET=

# ─── Ecosystem service-to-service (M2M) — Phase 3 ────────────────────────────
MCOM_SERVICE_ENABLED=true
MCOM_SERVICE_BASE_URL=http://localhost:5024
# Scopes this app may request from Central Hub (must match Console config)
# rewards:gift is required to gift admin/MCOM-created ("mcom vault") rewards.
# preaudit:read / audit:read are required to read 247GBS Audit data — Central
# validates requested scopes against THIS app's registry entry, so they must be
# registered on fundordonate (in addition to 247gbs-audit as the resource server).
MCOM_SERVICE_SCOPES=rewards:read rewards:issue rewards:gift preaudit:read audit:read

# ─── Ecosystem peer: MCOM Rewards provider API (direct app-to-app) ────────────
MCOM_REWARDS_BASE_URL=http://localhost:4000
MCOM_REWARDS_AUDIENCE=mcom-rewards
# Inbound lifecycle events are authenticated with an RS256 service token
# (audience "fundordonate") verified offline via Central's JWKS. No HMAC secret.
MCOM_REWARDS_EVENT_ISSUER=mcom-solutions
MCOM_REWARDS_EVENT_AUDIENCE=fundordonate
# Optional override; defaults to {MCOM_SOLUTIONS_URL}/.well-known/jwks.json
# MCOM_SOLUTIONS_JWKS_URL=https://auth.mcomsolutions.com/.well-known/jwks.json

# ─── Reward reconciliation safety net ────────────────────────────────────────
# Periodically mirror provider issuances and backfill missing ones.
REWARDS_RECONCILE_ENABLED=true
REWARDS_RECONCILE_INTERVAL_MS=900000

# ─── Ecosystem peer: 247GBS Audit (direct app-to-app, delegated reads) ────────
# FundOrDonate exchanges a signed-in user's MCOM SSO token for a delegated token
# (audience 247gbs-audit) and reads their pre-audit + audits directly. There is
# no user id in the path — identity comes from the token's `sub`.
AUDIT_API_BASE_URL=http://localhost:9008
AUDIT_WEB_URL=http://localhost:9009
AUDIT_AUDIENCE=247gbs-audit
AUDIT_SCOPES=preaudit:read audit:read

# Optional inbound "audit completed" events (service token, aud=fundordonate).
AUDIT_EVENTS_ENABLED=false
AUDIT_EVENT_SCOPE=audit:write

# Snapshot freshness + reconciliation safety net.
AUDIT_SNAPSHOT_TTL_MS=300000
AUDIT_RECONCILE_ENABLED=true
AUDIT_RECONCILE_INTERVAL_MS=900000
