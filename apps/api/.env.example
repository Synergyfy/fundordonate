# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5024
CORS_ORIGIN=http://localhost:5023

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# NOTE: the password is URL-encoded (e.g. `#` -> `%23`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fundordonate?schema=public

# ─── Redis (BullMQ + shared client + OAuth state store) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT (local sessions issued after SSO / admin login) ─────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key (32 bytes / 64 hex chars) for encrypting MCOM tokens at rest
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# ─── MCOM Solutions Central Hub (SSO / Identity) ─────────────────────────────
MCOM_SOLUTIONS_URL=http://localhost:3010
MCOM_CLIENT_ID=fundordonate
MCOM_CLIENT_SECRET=your-oauth-client-secret
# Server-to-server API key (alias: MCOM_SOLUTION_API_KEY)
MCOM_API_KEY=your-shared-system-api-key
MCOM_HMAC_SECRET=your-hmac-data-sharing-secret
MCOM_WEBHOOK_SECRET=your-webhook-signing-secret
MCOM_PLATFORM_SLUG=fundordonate
# Must exactly match a redirectUri registered for this client in MCOM Console
MCOM_REDIRECT_URI=http://localhost:5023/auth/callback
MCOM_SCOPES=profile email business membership packages

# Flow B — direct dashboard handshake shared secret (leave empty to disable)
SSO_SECRET=

# ─── Ecosystem service-to-service (M2M) — Phase 3 ────────────────────────────
MCOM_SERVICE_ENABLED=true
MCOM_SERVICE_BASE_URL=http://localhost:5024
MCOM_SERVICE_SCOPES=
