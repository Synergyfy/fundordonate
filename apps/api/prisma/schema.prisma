// FundorDonate API — Prisma schema
// Provider: PostgreSQL. Auth is federated through MCOM Solutions (Central Hub
// SSO); local credentials exist only for platform administrators.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  username      String? @unique
  password      String? // local password — admins only; SSO users have none
  firstName     String?
  lastName      String?
  avatar        String?
  role          String  @default("donor") // admin | fundraiser | collaborator | backer | donor
  userType      String  @default("consumer") // admin | business | consumer
  emailVerified Boolean @default(true) // SSO emails are verified by MCOM

  // ── MCOM Central Hub linkage ──
  mcomUserId         String?   @unique // Central user UUID (sub)
  mcomBusinessId     String? // Central business profile id
  mcomAccessToken    String? // encrypted Central OAuth access token
  mcomRefreshToken   String? // encrypted Central OAuth refresh token
  mcomTokenExpiresAt DateTime?
  mcomLinkedAt       DateTime?
  lastSsoSyncAt      DateTime?

  // ── Cached MCOM membership / entitlement snapshot ──
  membershipLevel        String?
  membershipPlanName     String?
  membershipStatus       String?
  membershipTier         String?
  hasPaidVerificationFee Boolean   @default(false)
  trialAccessExpiresAt   DateTime?
  appPlan                Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  subscription        Subscription?
  businesses          Business[]           @relation("BusinessOwner")
  contributions       Contribution[]       @relation("UserContributions")
  campaignPosts       CampaignPost[]       @relation("CampaignPostAuthor")
  createdCampaigns    BusinessCampaign[]   @relation("CampaignCreator")
  auditLogs           AuditLog[]
  foundingMemberships FoundingMembership[]

  @@index([mcomUserId])
  @@index([userType])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================================================================
// SUBSCRIPTION / ENTITLEMENT
// =============================================================================

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId   String?
  planName String?
  source   String? // membership | trial | direct
  status   String   @default("inactive")
  quotas   Json     @default("{}")
  limits   Json     @default("{}")
  features String[] @default([])

  isTrial            Boolean   @default(false)
  tasksToComplete    Json      @default("[]")
  membershipPlanName String?
  expiresAt          DateTime?
  isActive           Boolean   @default(false)

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planId])
  @@index([isActive])
  @@map("subscriptions")
}

// =============================================================================
// HUB LOCATION HIERARCHY (Spec Part 2 & Part 11)
// =============================================================================

enum HubLocationType {
  NATIONAL
  CITY
  BOROUGH
  DISTRICT
  LOCAL_AREA
  HIGH_STREET
  COMMERCIAL_AREA
}

enum HubLocationInternalState {
  DRAFT
  PLANNED
  PREPARING
  LAUNCHING
  ACTIVE_OPERATION
  ARCHIVED
}

model HubLocation {
  id                 String                   @id @default(uuid())
  name               String
  slug               String                   @unique
  type               HubLocationType          @default(CITY)
  parentId           String?
  parent             HubLocation?             @relation("LocationHierarchy", fields: [parentId], references: [id])
  children           HubLocation[]            @relation("LocationHierarchy")
  shortDescription   String?
  description        String?                  @db.Text
  heroHeadline       String?
  heroSupportingText String?
  postcodePrefix     String?
  latitude           Float?
  longitude          Float?
  /// Canonical hierarchy path (e.g. united-kingdom/manchester/northern-quarter).
  fullPath           String?
  isActive           Boolean                  @default(true)
  /// Distinct from isActive: controls public visibility even while operating.
  isPublic           Boolean                  @default(true)
  /// Internal admin workflow state; never exposed as the public status.
  internalState      HubLocationInternalState @default(DRAFT)
  /// Public activation status override resolved by the location service.
  statusOverride     String?
  /// Whether the location should appear on the UK map.
  mapEnabled         Boolean                  @default(true)
  mapZoomLevel       Int                      @default(6)
  primaryImage       String?
  secondaryImage     String?
  targetAmount       BigInt                   @default(0)
  activationStatus   String                   @default("PENDING") // PENDING | IN_PROGRESS | ACTIVATED | PAUSED
  metadata           Json                     @default("{}")
  /// Soft-delete marker. Deleted locations are hidden from every public and
  /// admin listing but remain in the database so history/attribution survives.
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  businesses            Business[]
  events                PlatformEvent[]
  foundingProgrammes    FoundingProgramme[]
  campaignLocations     CampaignLocation[]
  recommendationsAsCity LocationRecommendation[] @relation("CityLocationRecommendations")
  recommendationsAsArea LocationRecommendation[] @relation("AreaLocationRecommendations")

  @@index([parentId])
  @@index([type])
  @@index([slug])
  @@index([fullPath])
  @@index([mapEnabled])
  @@index([deletedAt])
  @@map("hub_locations")
}

enum RecommendationKind {
  HIGH_STREET
  LOCAL_AREA
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Community-submitted high street / local area suggestions reviewed by admins.
/// Approving one creates a suggested HubLocation under the submitted city/area.
model LocationRecommendation {
  id                String               @id @default(uuid())
  kind              RecommendationKind   @default(HIGH_STREET)
  name              String
  slug              String
  postcodes         String[]
  note              String?
  suggestedBy       String?
  submittedByRole   String // business | consumer
  cityId            String
  city              HubLocation          @relation("CityLocationRecommendations", fields: [cityId], references: [id], onDelete: Cascade)
  areaId            String?
  area              HubLocation?         @relation("AreaLocationRecommendations", fields: [areaId], references: [id], onDelete: SetNull)
  status            RecommendationStatus @default(PENDING)
  createdLocationId String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([cityId])
  @@index([areaId])
  @@map("location_recommendations")
}

// =============================================================================
// BUSINESS & LOCATION DOMAIN
// =============================================================================

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Local view of a business owner's 247GBS Audit link/pre-audit state.
/// Populated by the AuditDataService from a user-delegated read (or the
/// reconciliation job) — never entered by hand.
enum AuditLinkStatus {
  NOT_LINKED // owner has no MCOM identity, or has never signed into 247GBS Audit
  NO_PRE_AUDIT // linked, but no completed pre-audit exists
  CONSENT_REQUIRED // a pre-audit exists but has not been shared
  AVAILABLE // a consenting, completed pre-audit is readable
  ERROR // transient/unexpected failure talking to 247GBS Audit
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PreferredAudience {
  CONSUMER
  BUSINESS
  BOTH
}

model Business {
  id                 String            @id @default(uuid())
  ownerId            String
  owner              User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String            @unique
  registrationNumber String?
  businessType       String // "Restaurant & Cafe", "Retail & Shop", etc.
  category           String // e.g. "Food & Drink"
  subcategories      String[]          @default([])
  description        String?           @db.Text
  email              String
  phone              String?
  website            String?
  logoUrl            String?
  coverImageUrl      String?
  status             BusinessStatus    @default(ACTIVE)
  membershipTier     MembershipTier    @default(BRONZE)
  membershipExpiry   DateTime?
  preferredAudience  PreferredAudience @default(BOTH)
  campaignGoal       String?
  // ── DEPRECATED: fake pre-audit state (superseded by the 247GBS Audit read).
  //    Kept for one release so nothing crashes mid-migration; do not write.
  auditReference     String? // AUD-xxxxxx from Public Pre-Audit
  preAuditAnswers    Json              @default("{}") // Pre-audit cached answer tree

  // ── 247GBS Audit snapshot (source of truth = 247GBS Audit) ──
  auditLinkStatus          AuditLinkStatus @default(NOT_LINKED)
  auditPreAuditId          String? // 247GBS pre-audit session id
  auditRecommendedType     String? // SHORT_FORM | LONG_FORM
  auditDestinationType     String? // SHORT_FORM | LONG_FORM | FUND_OR_DONATE | ...
  auditDestinationTarget   String?
  auditConsentVersion      String?
  auditPreAuditCompletedAt DateTime?
  auditDiagnostic          Json? // full diagnosticSummary
  auditLinkedAt            DateTime? // first successful AVAILABLE read
  auditSyncedAt            DateTime? // last successful read
  auditLastError           String? // last failure reason / provider code

  // Location Hierarchy Linkage
  locationId String?
  location   HubLocation? @relation(fields: [locationId], references: [id])
  city       String
  localArea  String
  highStreet String
  address    String?
  postcode   String

  // Relations
  campaigns     BusinessCampaign[]
  contributions Contribution[]
  settings      BusinessSettings?
  payouts       PayoutRequest[]
  auditSessions AuditSessionMirror[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([city, localArea, highStreet])
  @@index([membershipTier])
  @@index([locationId])
  @@map("businesses")
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  emailAlerts        Boolean  @default(true)
  campaignUpdates    Boolean  @default(true)
  leaderboardChanges Boolean  @default(true)
  rewardsEarned      Boolean  @default(true)
  newBackers         Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("business_settings")
}

// =============================================================================
// 247GBS AUDIT MIRROR
// =============================================================================
// A local, read-only mirror of a business owner's audit sessions as returned by
// 247GBS Audit's partner API. Raw audit answers are never returned by the
// provider and are never stored here — only calculated metrics + AI insight.

model AuditSessionMirror {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// 247GBS audit session id (stable, unique across the provider).
  auditId           String   @unique
  status            String // TRIAGE_COMPLETED | SECTOR_SELECTED | IN_PROGRESS | COMPLETED | ABANDONED
  auditType         String?
  scopes            String[] @default([])
  sectorId          String?
  groupId           String?
  businessTypeId    String?
  preAuditSessionId String?
  calculatedMetrics Json? // capacityDrainPct, totalStockImpact, annualRecovery, impactScore
  aiInsight         Json?

  completedAt       DateTime?
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([businessId])
  @@index([status])
  @@map("audit_session_mirrors")
}

// =============================================================================
// CAMPAIGN TEMPLATE & BUSINESS INSTANCE DOMAIN
// =============================================================================

enum TemplateOrigin {
  AUDIT
  DIRECT
}

enum TemplateApprovalMode {
  AUTOMATIC
  ADMIN_REVIEW
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BusinessCampaignStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model CampaignTemplate {
  id                      String               @id @default(uuid())
  name                    String
  slug                    String               @unique
  tagline                 String
  seasonId                String?
  season                  Season?              @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  origin                  TemplateOrigin       @default(DIRECT)
  approvalMode            TemplateApprovalMode @default(ADMIN_REVIEW)
  status                  TemplateStatus       @default(DRAFT)
  category                String? // donation | crowdfunding | fund
  audience                String               @default("BOTH") // BUSINESS | CONSUMER | BOTH
  minEligibilityTier      MembershipTier       @default(BRONZE)
  minContributionRequired Boolean              @default(false)
  minContributionAmount   Int                  @default(0) // In pence
  selfFundingEnabled      Boolean              @default(true)
  selfFundingMode         String               @default("optional") // "optional" | "required"
  selfFundingAmount       Int                  @default(10000) // In pence (£100.00)
  selfFundingRewardName   String?
  // How a claiming business's own MCOM Rewards (business-owned) interact with
  // this template's rewards: "disabled" | "coexist" | "replace".
  // ("enabled" is a legacy alias for "coexist".)
  businessRewardsMode     String               @default("disabled")

  // Configurations
  fieldsConfig       Json @default("[]") // Blueprint of fields, locks, questions
  rewardsConfig      Json @default("[]") // Reward configs
  mcomAssetsConfig   Json @default("[]") // Assets/collateral
  requirementsConfig Json @default("[]") // Eligibility requirements
  config             Json @default("{}") // Full wizard config (sections, funding, location, visibility, access, contribution rules)

  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances BusinessCampaign[]

  @@index([isActive, seasonId])
  @@index([status, seasonId])
  @@map("campaign_templates")
}

model BusinessCampaign {
  id                   String                 @id @default(uuid())
  // Nullable: platform campaigns are created directly by admins and are not
  // owned by a business. Business campaigns keep both links.
  businessId           String?
  business             Business?              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  templateId           String?
  template             CampaignTemplate?      @relation(fields: [templateId], references: [id])
  /// Admin user who created a platform campaign (null for business campaigns).
  createdById          String?
  createdBy            User?                  @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                String
  description          String?                @db.Text
  shortDescription     String?
  status               BusinessCampaignStatus @default(DRAFT)
  /// Pins an admin-created campaign to the homepage featured carousel.
  isFeatured           Boolean                @default(false)
  targetAmount         Int // In pence
  raisedAmount         Int                    @default(0) // In pence
  businessContribution Int                    @default(0) // In pence (Self-funding)
  rewardTriggered      String?
  /// Presentation mode for platform campaigns ("fund" | "donation").
  /// Business campaigns derive this from their template origin.
  mode                 String?
  /// Audience for platform campaigns. Business campaigns derive this from the
  /// owning business.
  audience             PreferredAudience?
  category             String?
  imageUrl             String?
  startDate            DateTime?
  endDate              DateTime?
  backerCount          Int                    @default(0)
  /// Campaign-level settings: FAQ copy, terms and other presentation config.
  settings             Json                   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers           CampaignFieldAnswer[]
  requestedChanges  CampaignRequestedChange[]
  contributions     Contribution[]
  rewardAttachments CampaignRewardAttachment[]
  posts             CampaignPost[]
  locations         CampaignLocation[]

  @@index([businessId, status])
  @@index([templateId])
  @@index([createdById])
  @@index([status, isFeatured])
  @@index([status, endDate])
  @@map("business_campaigns")
}

enum CampaignLocationScope {
  PRIMARY
  SECONDARY
  INCLUDED
}

/// Attribution and visibility links between a campaign and the UK Hub
/// hierarchy. Exactly one PRIMARY row defines financial ownership.
model CampaignLocation {
  id         String                @id @default(uuid())
  campaignId String
  campaign   BusinessCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  locationId String
  location   HubLocation           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  scope      CampaignLocationScope @default(INCLUDED)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([campaignId, locationId])
  @@index([campaignId, scope])
  @@index([locationId, scope])
  @@map("campaign_locations")
}

model CampaignPost {
  id         String           @id @default(uuid())
  campaignId String
  campaign   BusinessCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?            @relation("CampaignPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title      String
  content    String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([campaignId, createdAt(sort: Desc)])
  @@map("campaign_posts")
}

model CampaignFieldAnswer {
  id         String           @id @default(uuid())
  campaignId String
  campaign   BusinessCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fieldId    String // identifier matching template field ID
  value      String           @db.Text
  source     String           @default("business_input") // "business_input", "audit", "template", etc.
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([campaignId, fieldId])
  @@index([campaignId])
  @@map("campaign_field_answers")
}

model CampaignRequestedChange {
  id         String           @id @default(uuid())
  campaignId String
  campaign   BusinessCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fieldId    String
  label      String
  note       String           @db.Text
  resolved   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([campaignId, resolved])
  @@map("campaign_requested_changes")
}

// =============================================================================
// CONTRIBUTIONS & TRANSACTION LEDGER
// =============================================================================

enum ContributionType {
  IN_STORE
  ONLINE
  FUNDING_SPLIT
  SELF_FUNDING
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Contribution {
  id              String             @id @default(uuid())
  /// Nullable for platform campaigns that are not owned by a business.
  businessId      String?
  business        Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        BusinessCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  backerId        String?
  backer          User?              @relation("UserContributions", fields: [backerId], references: [id])
  type            ContributionType
  status          ContributionStatus @default(COMPLETED)
  amount          Int // In pence
  reference       String             @unique // POS-001, WEB-042, SPLIT-012
  gateway         String? // "stripe", "paypal", "mcom_wallet", "pos_terminal"
  paymentIntentId String?
  mcomChargeId    String?            @unique
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now())

  @@index([businessId, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@index([type])
  @@map("contributions")
}

// =============================================================================
// REWARDS & GAMIFICATION
//
// Legacy `RewardDefinition` / `BusinessEarnedReward` models retired — campaign
// rewards are authored on `CampaignTemplate.rewardsConfig` and issued/tracked
// via `RewardIssuance` (MCOM Rewards mirror + local rewards).
// =============================================================================

// =============================================================================
// SEASONS & CAMPAIGN CYCLES
// =============================================================================

model Season {
  id                String   @id @default(uuid())
  name              String
  programmeName     String?
  referenceCode     String?  @unique
  description       String?  @db.Text
  publicDescription String?  @db.Text
  internalNotes     String?  @db.Text
  status            String   @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | CLOSING | REVIEW | COMPLETED | ARCHIVED
  startDate         DateTime
  endDate           DateTime
  durationDays      Int      @default(90)

  // Targets in pence
  overallTarget                 BigInt @default(0)
  nationalTarget                BigInt @default(0)
  cityTargetDefault             BigInt @default(0)
  localAreaTargetDefault        BigInt @default(0)
  highStreetTargetDefault       BigInt @default(0)
  businessCampaignTargetDefault BigInt @default(0)

  // Aggregate metrics cache
  totalRaised        BigInt @default(0)
  totalContributions Int    @default(0)
  activeCampaigns    Int    @default(0)
  totalParticipants  Int    @default(0)

  // Configuration snapshots
  activationScope     Json @default("{}")
  participationConfig Json @default("{}")
  engagementConfig    Json @default("{}")
  spilloverConfig     Json @default("{}")
  communicationConfig Json @default("{}")

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activatedAt DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  templates CampaignTemplate[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("seasons")
}

// =============================================================================
// PLATFORM EVENTS
// =============================================================================

model PlatformEvent {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  scope       String       @default("NATIONAL") // NATIONAL | CITY | LOCAL
  locationId  String?
  location    HubLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  eventDate   DateTime
  endDate     DateTime?
  venue       String?
  isPublished Boolean      @default(true)
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([eventDate])
  @@index([scope, locationId])
  @@index([isPublished])
  @@map("platform_events")
}

// =============================================================================
// PLATFORM SETTINGS
// =============================================================================

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   @default("general") // general | payment | fee | security | notifications
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("platform_settings")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// =============================================================================
// REWARD FULFILMENT
//
// Legacy `RewardFulfilment` retired — reward delivery/lifecycle now lives on
// `RewardIssuance` (status/code/expiry mirrored from MCOM Rewards).
// =============================================================================

// (removed model RewardFulfilment)

// =============================================================================
// MCOM REWARD ISSUANCES (mirror of rewards issued by the MCOM Rewards engine)
// =============================================================================

/**
 * Local mirror of a reward issued by the MCOM Rewards provider API. The reward
 * catalogue + fulfilment live in MCOM Rewards; FundOrDonate stores the
 * reference (issuance id, code, status) for display and reconciliation.
 */
model RewardIssuance {
  id                 String    @id @default(uuid())
  /**
   * Provider issuance id (unique per issuance in MCOM Rewards).
   */
  externalIssuanceId String    @unique
  mcomRewardId       String
  rewardTitle        String?
  rewardType         String?
  /**
   * Correlation ref sent to the provider (e.g. campaignId).
   */
  externalRef        String?
  /**
   * Stable idempotency key used when issuing.
   */
  idempotencyKey     String    @unique
  campaignId         String?
  /**
   * Reward rule (config id within the campaign) this issuance satisfies.
   */
  rewardConfigId     String?
  /**
   * Business-owned MCOM reward id when issued from a business's own reward.
   */
  businessRewardId   String?
  contributionId     String?
  userId             String?
  mcomUserId         String?
  recipientEmail     String?
  recipientName      String?
  // PENDING (reserved, provider call in flight) | ISSUED | REDEEMED | EXPIRED | REVOKED | FAILED
  status             String    @default("ISSUED")
  code               String?
  value              Int?
  quantity           Int       @default(1)
  metadata           Json?
  expiresAt          DateTime?
  redeemedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([campaignId])
  @@index([campaignId, rewardConfigId])
  @@index([externalRef])
  @@index([userId])
  @@index([mcomRewardId])
  @@index([businessRewardId])
  @@index([status])
  @@map("reward_issuances")
}

/// A business-owned MCOM Rewards reward attached to a campaign the business
/// runs. Coexists with the template-level rewards (`CampaignTemplate.
/// rewardsConfig`); the trigger engine evaluates these independently (each on
/// its own `conditions`) and issues them via the MCOM business-reward endpoint.
model CampaignRewardAttachment {
  id                String           @id @default(uuid())
  campaignId        String
  campaign          BusinessCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// MCOM Rewards business-reward id (from `/partner/business-rewards`).
  businessRewardId  String
  /// Snapshot for display (kept in sync on attach).
  title             String
  description       String?
  image             String?
  rewardType        String?
  /// Eligibility conditions: [{ id, mode, minPence, maxPence, exactPence }].
  conditions        Json             @default("[]")
  /// Evaluation mode for this attachment: "independent" | "cumulative".
  qualificationMode String           @default("independent")
  enabled           Boolean          @default(true)
  /// Local cap mirror (null = provider's own cap is authoritative).
  maxQuantity       Int?
  expiresAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([campaignId, businessRewardId])
  @@index([campaignId])
  @@map("campaign_reward_attachments")
}

// =============================================================================
// PAYOUT REQUESTS
// =============================================================================

model PayoutRequest {
  id                 String    @id @default(uuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount             Int // In pence
  currency           String    @default("GBP")
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  method             String    @default("bank_transfer")
  destinationDetails Json      @default("{}")
  processedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([businessId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("payout_requests")
}

// =============================================================================
// FOUNDING MEMBERSHIP PROGRAMMES
// =============================================================================

enum FoundingAudience {
  BUSINESS
  CONSUMER
}

enum FoundingProgrammeStatus {
  OPEN
  LIMITED
  FULLY_ALLOCATED
  CLOSED
  ARCHIVED
}

enum FoundingMembershipStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

model FoundingProgramme {
  id                 String                  @id @default(uuid())
  locationId         String
  location           HubLocation             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  audience           FoundingAudience
  title              String
  description        String?                 @db.Text
  status             FoundingProgrammeStatus @default(OPEN)
  totalAllocation    Int                     @default(0)
  allocatedCount     Int                     @default(0)
  opensAt            DateTime?
  closesAt           DateTime?
  /// Price matrix keyed by "{metal}_{level}" in minor units (pence).
  contributionConfig Json                    @default("{}")
  benefitConfig      Json                    @default("[]")
  eligibilityConfig  Json                    @default("{}")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  memberships FoundingMembership[]

  @@unique([locationId, audience])
  @@index([locationId])
  @@index([status])
  @@map("founding_programmes")
}

model FoundingMembership {
  id                 String                   @id @default(uuid())
  programmeId        String
  programme          FoundingProgramme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               MembershipTier           @default(BRONZE)
  accessLevel        String                   @default("standard") // standard | pro | pro_plus
  status             FoundingMembershipStatus @default(PENDING)
  contributionAmount BigInt                   @default(0) // minor units (pence)
  isMonthly          Boolean                  @default(false)
  reference          String?
  startedAt          DateTime                 @default(now())
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([programmeId, userId])
  @@index([programmeId])
  @@index([userId])
  @@index([status])
  @@map("founding_memberships")
}

// =============================================================================
// SUPPORT TICKETS
// =============================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String?
  name      String
  email     String
  topic     String
  subject   String?
  message   String              @db.Text
  status    SupportTicketStatus @default(OPEN)
  source    String              @default("web") // web | consumer_dashboard
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@map("support_tickets")
}
