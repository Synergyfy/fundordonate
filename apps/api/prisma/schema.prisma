generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  firstName     String?
  lastName      String?
  avatar        String?
  bio           String?
  role          String    @default("donor") // admin, fundraiser, collaborator, backer, donor
  userType      String    @default("consumer") // consumer, business, admin
  businessId    String?   // links user to a Business entity (future)
  emailVerified Boolean   @default(false)
  notifications String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  campaigns             Campaign[]
  fundraiserCampaigns   Campaign[]           @relation("FundraiserCampaigns")
  donations             Donation[]
  pledges               Pledge[]
  bookmarks             Bookmark[]
  activities            Activity[]
  createdActivities     Activity[]           @relation("ActivityCreator")
  comments              Comment[]
  wallet                Wallet?
  withdrawalRequests    WithdrawalRequest[]
  collaborators         CampaignCollaborator[]
  rewardItemDownloads   RewardItemDownload[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  verificationTokens    EmailVerificationToken[]
  memberships           UserMembership[]
  // UK Hub relations
  foundingMemberships   FoundingMembership[]
  backerStatuses        BackerStatus[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// =============================================================================
// CAMPAIGN
// =============================================================================

model Campaign {
  id              String   @id @default(uuid())
  slug            String   @unique
  permalink       String?  @unique
  title           String
  shortDescription String?
  description     String?
  goalAmount      Int
  raisedAmount    Int      @default(0)
  deadline        DateTime
  status          String   @default("draft") // draft, submitted, pending_review, approved, rejected, published, active, paused, completed, cancelled, expired, archived
  mode            String   @default("donation") // donation, crowdfunding, fund, sponsor
  featuredImage   String?
  videoUrl        String?
  platformFee     Int?
  settings        String   @default("{}")

  // FundOrDonate Architecture Fields
  creatorType     String   @default("admin") // admin, business, fundraiser, consumer
  ownerContribution Int    @default(0) // business owner's own contribution (in cents)
  campaignTarget  Int      @default(0) // total campaign target (in cents), 0 means use goalAmount
  approvedById    String?
  publishedById   String?
  approvedAt      DateTime?
  publishedAt     DateTime?
  submittedAt     DateTime?
  rejectedAt      DateTime?
   rejectionReason String?

  // Campaign Hierarchy
  parentId        String?  // parent campaign ID (campaign-inside-campaign)
  parent          Campaign?  @relation("CampaignHierarchy", fields: [parentId], references: [id])
  children        Campaign[] @relation("CampaignHierarchy")

  // Campaign Context
  location        String?  // city, borough, high street, or UK location name
  isEvergreen     Boolean  @default(false) // evergreen (always available) vs seasonal

  // Participation Configuration
  participationTypes String @default("[]") // JSON array: ["fund","donate","sponsor"] — which modes this campaign supports
  backerTiersEnabled Boolean @default(false) // whether this campaign shows Standard/Pro/Pro+ selection
  recurringEnabled   Boolean @default(false) // whether monthly/recurring contributions are allowed

  // Self-Funding Configuration
  selfFundingLevel   String?  // bronze, silver, gold, platinum — only set for self-funding campaigns
  isSelfFunding      Boolean  @default(false) // whether this is a self-funding campaign

  // Share/QR Architecture
  shareCode       String?  @unique // stable short code for share URLs and QR codes

  // Taxonomy & Classification
  campaignTypeId  String?
  seasonId        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Foreign Keys
  authorId        String
  fundraiserId    String?
  categoryId      String?
  fundId          String?
  membershipPlanId String?

  // Relations
  author              User                  @relation(fields: [authorId], references: [id])
  fundraiser          User?                 @relation("FundraiserCampaigns", fields: [fundraiserId], references: [id])
  category            Category?             @relation(fields: [categoryId], references: [id])
  fund                Fund?                 @relation(fields: [fundId], references: [id])
  campaignType        CampaignType?         @relation(fields: [campaignTypeId], references: [id])
  season              CampaignSeason?       @relation(fields: [seasonId], references: [id])
  membershipPlan      MembershipPlan?       @relation(fields: [membershipPlanId], references: [id])
  groups              CampaignGroupMembership[]
  collections         CampaignCollectionMembership[]
  events              CampaignEventMembership[]
  images              CampaignImage[]
  tags                CampaignTag[]
  collaborators       CampaignCollaborator[]
  rewards             Reward[]
  donations           Donation[]
  pledges             Pledge[]
  bookmarks           Bookmark[]
  activities          Activity[]
  posts               CampaignPost[]
  comments            Comment[]
  snapshots           CampaignSnapshot[]
  walletTransactions  WalletTransaction[]
  withdrawalItems     WithdrawalItem[]
  shares              CampaignShare[]
  // UK Hub relations
  campaignLocations   CampaignLocation[]
  foundingProgrammes  FoundingProgramme[]
  foundingMemberships FoundingMembership[]
  backerStatuses      BackerStatus[]

  @@index([authorId])
  @@index([fundraiserId])
  @@index([categoryId])
  @@index([fundId])
  @@index([campaignTypeId])
  @@index([seasonId])
  @@index([membershipPlanId])
  @@index([parentId])
  @@index([status])
  @@index([mode])
  @@index([deadline])
  @@index([createdAt])
  @@index([status, mode]) // compound: filter by status+mode
  @@index([authorId, status]) // compound: author's published campaigns
  @@map("campaigns")
}

model CampaignImage {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_images")
}

model CampaignCollaborator {
  campaignId     String
  collaboratorId String
  createdAt      DateTime @default(now())

  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collaborator User     @relation(fields: [collaboratorId], references: [id])

  @@id([campaignId, collaboratorId])
  @@index([collaboratorId])
  @@map("campaign_collaborators")
}

model CampaignSnapshot {
  id        String   @id @default(uuid())
  snapshot  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId])
  @@map("campaign_snapshots")
}

// =============================================================================
// MEMBERSHIP
// =============================================================================

model MembershipPlan {
  id          String   @id @default(uuid())
  name        String   // e.g. "Bronze Pro+", "Silver Standard"
  slug        String   @unique
  tier        String   // bronze, silver, gold, platinum
  level       String   // standard, pro, pro+
  description String?
  price       Int      @default(0) // price in cents
  duration    Int?     // duration in days, null = lifetime
  status      String   @default("active") // active, inactive
  order       Int      @default(0)
  entitlements String  @default("{}") // JSON: campaign eligibility, limits, rewards, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserMembership[]
  campaigns   Campaign[]

  @@unique([tier, level])
  @@index([status])
  @@index([tier])
  @@map("membership_plans")
}

model UserMembership {
  id          String   @id @default(uuid())
  status      String   @default("active") // active, expired, cancelled
  startDate   DateTime @default(now())
  endDate     DateTime?
  autoRenew   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  planId   String
  plan     MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([userId, status]) // compound: user's active memberships
  @@map("user_memberships")
}

// =============================================================================
// CAMPAIGN TAXONOMY
// =============================================================================

model CampaignType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  status      String   @default("active") // active, inactive
  order       Int      @default(0)

  // Opportunity Configuration
  isOpportunity    Boolean  @default(false) // whether this type represents an approved campaign opportunity
  eligibleTiers    String   @default("[]") // JSON array: ["bronze","silver","gold","platinum"]
  eligibleLevels   String   @default("[]") // JSON array: ["standard","pro","pro+"]
  parentInitiative String?  // name of the parent initiative this opportunity belongs to

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@map("campaign_types")
}

model CampaignSeason {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("active") // active, inactive
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("campaign_seasons")
}

model CampaignGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  status      String   @default("active") // active, inactive
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns CampaignGroupMembership[]

  @@map("campaign_groups")
}

model CampaignGroupMembership {
  campaignId  String
  groupId     String
  createdAt   DateTime @default(now())

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    CampaignGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
  @@index([groupId])
  @@map("campaign_group_memberships")
}

model CampaignCollection {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  status      String   @default("active") // active, inactive
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns CampaignCollectionMembership[]

  @@map("campaign_collections")
}

model CampaignCollectionMembership {
  campaignId   String
  collectionId String
  createdAt    DateTime @default(now())

  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collection CampaignCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([campaignId, collectionId])
  @@index([collectionId])
  @@map("campaign_collection_memberships")
}

model CampaignEvent {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("active") // active, inactive
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns CampaignEventMembership[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("campaign_events")
}

model CampaignEventMembership {
  campaignId String
  eventId    String
  createdAt  DateTime @default(now())

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  event    CampaignEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([campaignId, eventId])
  @@index([eventId])
  @@map("campaign_event_memberships")
}

// =============================================================================
// CAMPAIGN ENGAGEMENT
// =============================================================================

model CampaignPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
  @@map("campaign_posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  status    String   @default("approved") // approved, pending, spam
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  userId     String
  parentId   String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([campaignId])
  @@index([userId])
  @@index([parentId])
  @@index([status])
  @@map("comments")
}

model Bookmark {
  createdAt DateTime @default(now())

  campaignId String
  userId     String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([campaignId, userId])
  @@index([userId])
  @@map("bookmarks")
}

model Activity {
  id        String   @id @default(uuid())
  type      String
  data      String   @default("{}")
  createdAt DateTime @default(now())

  campaignId  String?
  pledgeId    String?
  donationId  String?
  userId      String?
  createdById String?

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  pledge     Pledge?   @relation(fields: [pledgeId], references: [id])
  donation   Donation? @relation(fields: [donationId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])
  createdBy  User?     @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([campaignId])
  @@index([pledgeId])
  @@index([donationId])
  @@index([userId])
  @@index([createdById])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

// =============================================================================
// CATEGORIES & TAGS
// =============================================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  campaignTags CampaignTag[]

  @@map("tags")
}

model CampaignTag {
  campaignId String
  tagId      String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@index([tagId])
  @@map("campaign_tags")
}

// =============================================================================
// REWARDS (Crowdfunding Mode)
// =============================================================================

model Reward {
  id           String   @id @default(uuid())
  title        String
  description  String?
  amount       Int
  deliveryDate DateTime?
  limit        Int?
  status       String   @default("active") // active, inactive
  order        Int      @default(0)

  // Reward Type & E-card Fields
  rewardType    String   @default("standard") // standard, ecard, cashback, points, discount
  statedValue   Int      @default(0) // face/stated value in cents (e.g. E-card £10 = 1000)
  benefitValue  Int      @default(0) // actual benefit value in cents
  currency      String   @default("GBP")
  eligibility   String   @default("{}") // JSON: membership, contribution rules
  conversionRule String  @default("{}") // JSON: contribution-to-reward conversion config

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pledges    Pledge[]
  items      RewardItem[]

  @@index([campaignId])
  @@index([amount])
  @@index([rewardType])
  @@map("rewards")
}

model RewardItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  quantity    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewardId String
  reward   Reward             @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  downloads RewardItemDownload[]

  @@index([rewardId])
  @@map("reward_items")
}

model RewardItemDownload {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())

  rewardItemId String
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  @@index([rewardItemId])
  @@index([userId])
  @@map("reward_item_downloads")
}

// =============================================================================
// FUNDS
// =============================================================================

model Fund {
  id          String   @id @default(uuid())
  title       String
  description String?
  isDefault   Boolean  @default(false)
  status      String   @default("active") // active, inactive
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  campaigns Campaign[]
  donations Donation[]

  @@index([status])
  @@map("funds")
}

// =============================================================================
// DONATIONS
// =============================================================================

model Donation {
  id                     String   @id @default(uuid())
  uid                    String   @unique
  amount                 Int
  recoveryFee            Int      @default(0)
  processingFee          Int      @default(0)
  tributeType            String?  // in_honor, in_memory
  tributeSalutation      String?
  tributeTo              String?
  tributeNotificationEmail   String?
  tributeNotificationMessage String?
  notes                  String?
  status                 String   @default("pending") // pending, completed, failed, refunded
  transactionId          String?
  paymentEngine          String?  // native, woocommerce
  paymentMethod          String?
  paymentStatus          String?
  isAnonymous            Boolean  @default(false)
  isManual               Boolean  @default(false)
  userInfo               String   @default("{}")

  // FundOrDonate Contribution Architecture
  contributionType      String   @default("external") // owner, external
  currency              String   @default("GBP")

  createdAt              DateTime @default(now())
  createdBy              String?
  updatedAt              DateTime @updatedAt
  updatedBy              String?

  // Foreign Keys
  campaignId String
  fundId     String?
  userId     String?

  // Relations
  campaign           Campaign             @relation(fields: [campaignId], references: [id])
  fund               Fund?                @relation(fields: [fundId], references: [id])
  user               User?                @relation(fields: [userId], references: [id])
  activities         Activity[]
  walletTransactions WalletTransaction[]

  @@index([campaignId])
  @@index([fundId])
  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@index([campaignId, status]) // compound: campaign donations by status
  @@index([userId, createdAt]) // compound: user donation history
  @@map("donations")
}

// =============================================================================
// PLEDGES (Crowdfunding Mode)
// =============================================================================

model Pledge {
  id                 String   @id @default(uuid())
  uid                String   @unique
  status             String   @default("pending") // pending, completed, failed, cancelled
  pledgeOption       String?
  amount             Int
  bonusSupportAmount Int      @default(0)
  shippingCost       Int      @default(0)
  recoveryFee        Int      @default(0)
  processingFee      Int      @default(0)
  notes              String?
  transactionId      String?
  paymentEngine      String?  // native, woocommerce
  paymentMethod      String?
  paymentStatus      String?
  isManual           Boolean  @default(false)
  rewardInfo         String   @default("{}")
  userInfo           String   @default("{}")
  createdAt          DateTime @default(now())
  createdBy          String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  // Foreign Keys
  campaignId String
  userId     String?
  rewardId   String?

  // Relations
  campaign           Campaign             @relation(fields: [campaignId], references: [id])
  user               User?                @relation(fields: [userId], references: [id])
  reward             Reward?              @relation(fields: [rewardId], references: [id])
  activities         Activity[]
  walletTransactions WalletTransaction[]

  @@index([campaignId])
  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@index([campaignId, status]) // compound: campaign pledges by status
  @@index([userId, createdAt]) // compound: user pledge history
  @@map("pledges")
}

// =============================================================================
// WALLET & TRANSACTIONS
// =============================================================================

model Wallet {
  id              String   @id @default(uuid())
  balance         Int      @default(0)
  requestedAmount Int      @default(0)
  withdrawAmount  Int      @default(0)
  platformFee     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  amount        Int
  action        String   // credit, debit
  type          String   // earning, platform_fee, withdrawal_request, withdrawal_approval, withdrawal_rejection
  status        String   @default("pending") // pending, completed
  referenceId   String?
  referenceType String?  // pledge, donation, withdrawal_request
  createdAt     DateTime @default(now())

  // Foreign Keys
  walletId   String
  campaignId String?
  pledgeId   String?
  donationId String?

  // Relations
  wallet   Wallet    @relation(fields: [walletId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  pledge   Pledge?   @relation(fields: [pledgeId], references: [id])
  donation Donation? @relation(fields: [donationId], references: [id])

  @@index([walletId])
  @@index([campaignId])
  @@index([pledgeId])
  @@index([donationId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// =============================================================================
// WITHDRAWALS
// =============================================================================

model WithdrawalRequest {
  id         String   @id @default(uuid())
  amount     Int
  method     String   // paypal, bank, others
  status     String   @default("pending") // pending, approved, rejected
  note       String?
  attachment String?
  payoutInfo String   @default("{}")
  createdAt  DateTime @default(now())
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
  items  WithdrawalItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status]) // compound: user's pending withdrawals
  @@map("withdrawal_requests")
}

model WithdrawalItem {
  amount    Int

  withdrawalRequestId String
  campaignId          String

  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  campaign          Campaign          @relation(fields: [campaignId], references: [id])

  @@id([withdrawalRequestId, campaignId])
  @@index([campaignId])
  @@map("withdrawal_items")
}

// =============================================================================
// MCOM INTEGRATION
// =============================================================================

model ExternalReference {
  id           String   @id @default(uuid())
  provider     String   // central_hub, vcard, terminal, mcom_rewards, mcom_mall
  entityType   String   // user, campaign, donation, reward, ecard, pledge
  entityId     String   // internal FundOrDonate entity ID
  externalId   String   // external MCOM entity ID
  externalData String   @default("{}") // JSON: metadata from external system
  status       String   @default("pending") // pending, active, failed, revoked, cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, entityType, entityId])
  @@unique([provider, entityType, externalId])
  @@index([entityType, entityId])
  @@index([provider])
  @@index([externalId])
  @@index([status])
  @@map("external_references")
}

// =============================================================================
// QR / LINK / SHARE
// =============================================================================

model CampaignShare {
  id          String   @id @default(uuid())
  code        String   @unique // short share code for URLs/QR
  shareType   String   // link, qr, referral, social
  source      String?  // where the share originated
  metadata    String   @default("{}") // JSON: tracking data
  createdAt   DateTime @default(now())

  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([code])
  @@index([shareType])
  @@map("campaign_shares")
}

// =============================================================================
// UK HUB ACTIVATION
// =============================================================================

model HubLocation {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  type              String   // NATIONAL, CITY, BOROUGH, DISTRICT, LOCAL_AREA, HIGH_STREET, COMMERCIAL_AREA
  parentId          String?
  parent            HubLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children          HubLocation[] @relation("LocationHierarchy")

  // Content
  shortDescription  String?
  description       String?
  heroHeadline      String?
  heroSupportingText String?

  // Activation
  internalLifecycle String   @default("DRAFT")
  publicStatus      String   @default("NEEDS_ACTIVATION")
  statusOverride    String?

  // Publication
  isActive          Boolean  @default(false)
  isPublic          Boolean  @default(false)

  // Map
  mapVisible        Boolean  @default(false)
  latitude          Float?
  longitude         Float?
  mapZoomLevel      Int?     @default(10)

  // Media
  primaryImage      String?
  secondaryImage    String?

  // Hierarchy path
  fullPath          String?  @unique

  // Featured
  isFeaturedNationally Boolean @default(false)
  featuredPriority     Int?    @default(0)
  featuredFrom         DateTime?
  featuredUntil        DateTime?

  // Progress
  fundingTarget        Int    @default(0)
  fundingRaised        Int    @default(0)
  activationThreshold  Int?   @default(80)

  // Founding allocation
  foundingBusinessTotal     Int  @default(0)
  foundingBusinessAllocated Int  @default(0)
  foundingConsumerTotal     Int  @default(0)
  foundingConsumerAllocated Int  @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns           CampaignLocation[]
  foundingProgrammes  FoundingProgramme[]
  foundingMemberships FoundingMembership[]
  backerStatuses      BackerStatus[]
  activity            HubActivity[]
  events              HubEvent[]
  statusHistory       LocationStatusHistory[]

  @@index([type])
  @@index([parentId])
  @@index([slug])
  @@index([fullPath])
  @@index([isPublic, isActive])
  @@index([type, publicStatus])
  @@index([isFeaturedNationally])
  @@map("hub_locations")
}

model CampaignLocation {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  locationId      String
  location        HubLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  relationshipType String @default("PRIMARY")
  visibility      String   @default("VISIBLE")
  createdAt       DateTime @default(now())

  @@unique([campaignId, locationId])
  @@index([campaignId])
  @@index([locationId])
  @@index([locationId, relationshipType])
  @@map("campaign_locations")
}

model FoundingProgramme {
  id                String   @id @default(uuid())
  locationId        String
  location          HubLocation @relation(fields: [locationId], references: [id])
  audience          String   // BUSINESS, CONSUMER
  status            String   @default("DRAFT")
  title             String
  description       String?
  totalAllocation   Int      @default(0)
  allocatedCount    Int      @default(0)
  opensAt           DateTime?
  closesAt          DateTime?
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])
  contributionConfig String  @default("{}")
  benefitConfig     String   @default("[]")
  eligibilityConfig String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships       FoundingMembership[]

  @@index([locationId])
  @@index([locationId, audience])
  @@index([status])
  @@index([campaignId])
  @@map("founding_programmes")
}

model FoundingMembership {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  programmeId       String
  programme         FoundingProgramme @relation(fields: [programmeId], references: [id])
  locationId        String
  location          HubLocation @relation(fields: [locationId], references: [id])
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id])
  status            String   @default("ACTIVE")
  contributionAmount Int?
  grantedAt         DateTime @default(now())
  benefitsVersion   String?

  @@unique([userId, programmeId])
  @@index([userId])
  @@index([programmeId])
  @@index([locationId])
  @@map("founding_memberships")
}

model BackerStatus {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  statusType        String   @default("BACKER")
  sourceCampaignId  String?
  sourceCampaign    Campaign? @relation(fields: [sourceCampaignId], references: [id])
  locationId        String?
  location          HubLocation? @relation(fields: [locationId], references: [id])
  grantedAt         DateTime @default(now())
  visibility        String   @default("COUNTED")
  metadata          String   @default("{}")

  @@unique([userId, sourceCampaignId])
  @@index([userId])
  @@index([locationId])
  @@index([sourceCampaignId])
  @@map("backer_statuses")
}

model HubActivity {
  id              String   @id @default(uuid())
  locationId      String
  location        HubLocation @relation(fields: [locationId], references: [id])
  activityType    String   // ANNOUNCEMENT, MILESTONE, CAMPAIGN_UPDATE, FOUNDING_MILESTONE, LAUNCH, COMMUNITY
  title           String
  content         String?
  media           String?
  publicationStatus String @default("DRAFT")
  publishedAt     DateTime?
  visibilityScope String   @default("LOCATION")
  createdAt       DateTime @default(now())

  @@index([locationId])
  @@index([locationId, activityType])
  @@index([publicationStatus])
  @@map("hub_activity")
}

model HubEvent {
  id              String   @id @default(uuid())
  locationId      String
  location        HubLocation @relation(fields: [locationId], references: [id])
  title           String
  description     String?
  eventDate       DateTime?
  status          String   @default("DRAFT")
  ctaLabel        String?
  ctaUrl          String?
  eligibleAudience String?  // JSON: which founding/backer audiences
  createdAt       DateTime @default(now())

  @@index([locationId])
  @@index([eventDate])
  @@map("hub_events")
}

model LocationStatusHistory {
  id              String   @id @default(uuid())
  locationId      String
  location        HubLocation @relation(fields: [locationId], references: [id])
  previousStatus  String?
  newStatus       String
  previousLifecycle String?
  newLifecycle    String?
  changedByUserId String?
  reason          String?
  createdAt       DateTime @default(now())

  @@index([locationId])
  @@index([createdAt])
  @@map("location_status_history")
}
