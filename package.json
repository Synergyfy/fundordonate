{
  "name": "fundordonate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @fundordonate/api dev",
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"pnpm dev:web\" \"pnpm dev:api\"",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter @fundordonate/api build",
    "build": "pnpm build:web && pnpm build:api",
    "test": "pnpm --filter web test",
    "db:migrate": "pnpm --filter @fundordonate/api prisma:migrate",
    "db:generate": "pnpm --filter @fundordonate/api prisma:generate",
    "db:seed": "pnpm --filter @fundordonate/api prisma:seed",
    "db:studio": "pnpm --filter @fundordonate/api prisma:studio",
    "db:push": "pnpm --filter @fundordonate/api db:push",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8"
  }
}
